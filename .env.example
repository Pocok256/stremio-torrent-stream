# Server Configuration
PORT=58827
HTTPS_PORT=58828
NODE_ENV=production

# HTTPS Method (local-ip.medicmobile.org or localtunnel)
HTTPS_METHOD=local-ip.medicmobile.org

# Torrent Settings
DOWNLOAD_DIR=/data
KEEP_DOWNLOADED_FILES=false
MAX_CONNS_PER_TORRENT=50
DOWNLOAD_SPEED_LIMIT=60971520  # 60 MB/s in bytes
UPLOAD_SPEED_LIMIT=60971520    # 60 MB/s in bytes
SEED_TIME=172800000            # 48 hours in milliseconds
TORRENT_TIMEOUT=5000           # 5 seconds in milliseconds

# Error Tracking (Optional)
# Get your DSN from https://sentry.io/
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
